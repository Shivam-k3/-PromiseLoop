# --- PromiseLoop backend configuration -------------------------------------
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# All secrets live here; nothing sensitive is hard-coded in the source tree.

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL connection string (Project Settings -> Connect).
# The backend accepts the dashboard's postgresql:// URI and enables asyncpg.
# For local development without Supabase use:
#   DATABASE_URL=sqlite+aiosqlite:///./promiseloop.db
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Demo user bootstrap. The API key below is hashed before it is stored.
SEED_API_KEY=replace-with-a-long-random-string
SEED_USER_EMAIL=demo@promiseloop.local

# --- AI provider -----------------------------------------------------------
# "mock"   -> offline deterministic extractor (no API key, no network)
# "openai" -> any OpenAI-compatible /chat/completions endpoint
#             (OpenAI, Amazon Bedrock, Groq, OpenRouter, Ollama, ...)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- MCP -------------------------------------------------------------------
# How the assistant reaches the MCP server.
#   memory - in-process (default, fastest, no second process)
#   stdio  - spawns `python -m app.mcp_server.server` as a subprocess
#   http   - streamable HTTP against a separately running MCP server
#            (start it with: python -m app.mcp_server.server --http --port 8001)
MCP_TRANSPORT=memory
MCP_HTTP_URL=http://127.0.0.1:8001/mcp
# Only used by the stdio transport. Leave empty to spawn the module directly.
MCP_SERVER_COMMAND=
MCP_STARTUP_TIMEOUT=30
